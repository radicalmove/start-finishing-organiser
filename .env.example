# Copy this file to `.env` and fill in values.
# `.env` is gitignored.

# Cozi iCalendar feed URL (optional)
COZI_ICS_URL=

# Single-user mode (recommended default)
SFO_SINGLE_USER_MODE=1
# Optional explicit DB path override:
# SFO_DATABASE_URL=sqlite:////Users/<you>/Library/Application Support/com.rcd58.sfo/sfo.db

# Authentication (recommended if accessing remotely)
SFO_PASSWORD=
SFO_SESSION_SECRET=
SFO_USERNAME=
SFO_API_TOKEN=
SFO_HTTPS_ONLY=
SFO_SESSION_SAMESITE=lax
SFO_SESSION_MAX_AGE=

# Coach (local LLM via Ollama; optional)
SFO_LLM_PROVIDER=auto
SFO_OLLAMA_URL=http://localhost:11434
SFO_OLLAMA_MODEL=llama3.1:8b
SFO_LLM_TIMEOUT=15
SFO_COACH_HISTORY_LIMIT=120

# Gmail inbox capture (optional)
SFO_GMAIL_ENABLED=
SFO_GMAIL_CLIENT_SECRETS=~/.config/sfo/gmail_credentials.json
SFO_GMAIL_TOKEN_PATH=~/.config/sfo/gmail_token.json
SFO_GMAIL_POLL_SECONDS=300
SFO_GMAIL_MAX_PER_SYNC=50
SFO_GMAIL_BACKFILL_DAYS=0
SFO_GMAIL_WORK_DOMAIN=
