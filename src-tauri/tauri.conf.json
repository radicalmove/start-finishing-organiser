{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Start Finishing Organiser",
  "version": "0.732.0",
  "identifier": "com.rcd58.sfo",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "windows": [
      {
        "title": "Start Finishing Organiser",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
